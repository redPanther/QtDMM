{
  "decoder": "M9803RContinuous",
  "comment": "Frames from the byte table in the header of src/device/decoders/m9803r.cpp (Matthias Toussaint's reverse engineering): the first ones built by hand; the ones marked 'web' are frames of a real M9803R as published on the web, with the reading the meter showed (passed on by Sarah, the original source is not recorded). dval is in SI base units (123.4 mV -> 0.1234). The 000.0 Ohm range is left out: the decoder puts the decimal point one place too far left compared with the table, and only a meter can settle it. Replace the hand-built ones with real data when available.",
  "tests": [
    {
      "comment": "DCV 0.000 V range: 1.234 V, auto (the same frame is among the web samples of a real meter)",
      "hex": "00 04 03 02 01 00 01 00 04 0D 0A",
      "expected": {
        "dval": 1.234,
        "unit": "V",
        "special": "DC",
        "range": "AUTO",
        "port": "voltage.dc"
      }
    },
    {
      "comment": "DCV 0.000 V range: -1.234 V",
      "hex": "08 04 03 02 01 00 01 00 04 0D 0A",
      "expected": {
        "dval": -1.234,
        "unit": "V",
        "special": "DC",
        "port": "voltage.dc"
      }
    },
    {
      "comment": "DCV 0000. V range: 1234 V",
      "hex": "00 04 03 02 01 00 04 00 04 0D 0A",
      "expected": {
        "val": "1234",
        "dval": 1234.0,
        "unit": "V",
        "special": "DC",
        "port": "voltage.dc"
      }
    },
    {
      "comment": "ACV 00.00 V range: 23.05 V, manual",
      "hex": "00 05 00 03 02 01 02 00 02 0D 0A",
      "expected": {
        "dval": 23.05,
        "unit": "V",
        "special": "AC",
        "range": "MANU",
        "port": "voltage.ac"
      }
    },
    {
      "comment": "DCV overload",
      "hex": "01 00 00 00 00 00 01 00 04 0D 0A",
      "expected": {
        "dval": 0.0,
        "unit": "V",
        "special": "DC",
        "port": "voltage.dc"
      }
    },
    {
      "comment": "Diode: 0.512 V",
      "hex": "00 02 01 05 00 06 00 00 04 0D 0A",
      "expected": {
        "dval": 0.512,
        "unit": "V",
        "special": "DI",
        "port": "voltage.diode"
      }
    },
    {
      "comment": "Ohms with beep, 000.0 Ohm: 123.4 Ohm",
      "hex": "00 04 03 02 01 05 00 00 04 0D 0A",
      "expected": {
        "dval": 123.4,
        "unit": "Ohm",
        "special": "OH",
        "port": "resistance"
      }
    },
    {
      "comment": "Frequency 00.00 Hz: 50.00 Hz",
      "hex": "00 00 00 00 05 0A 05 00 04 0D 0A",
      "expected": {
        "dval": 50.0,
        "unit": "Hz",
        "special": "HZ",
        "port": "frequency"
      }
    },
    {
      "comment": "web, real meter: +12.34 V DC",
      "hex": "00 04 03 02 01 00 02 00 04 0D 0A",
      "expected": {
        "dval": 12.34,
        "unit": "V",
        "special": "DC",
        "range": "AUTO",
        "port": "voltage.dc"
      }
    },
    {
      "comment": "web, real meter: -12.34 V DC",
      "hex": "08 04 03 02 01 00 02 00 04 0D 0A",
      "expected": {
        "dval": -12.34,
        "unit": "V",
        "special": "DC",
        "port": "voltage.dc"
      }
    },
    {
      "comment": "web, real meter: 123.4 mV DC",
      "hex": "00 04 03 02 01 00 00 00 04 0D 0A",
      "expected": {
        "val": "123.4",
        "dval": 0.1234,
        "unit": "mV",
        "special": "DC",
        "port": "voltage.dc"
      }
    },
    {
      "comment": "web, real meter: 0.623 V diode",
      "hex": "00 03 02 06 00 06 00 00 04 0D 0A",
      "expected": {
        "val": "0.623",
        "dval": 0.623,
        "unit": "V",
        "special": "DI",
        "port": "voltage.diode"
      }
    },
    {
      "comment": "web, real meter: 4.700 kOhm. The published frame 00 07 00 07 04 04 02 00 04 0D 0A decodes to 47.07 kOhm under the byte table, most likely a typo in the source; this is the frame the table gives for 4.700 kOhm (digits 0 0 7 4, decimal point 0x01)",
      "hex": "00 00 00 07 04 04 01 00 04 0D 0A",
      "expected": {
        "val": "4.700",
        "dval": 4700.0,
        "unit": "kOhm",
        "special": "OH",
        "port": "resistance"
      }
    }
  ]
}
