# QtDMM: the logged-in user may open the USB-HID cables and sensors of meters
# WCH CH9325 (UNI-T UT-D04)
KERNEL=="hidraw*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="e008", TAG+="uaccess"
